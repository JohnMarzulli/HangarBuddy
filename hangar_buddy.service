# Move this file to /etc/systemd/system
# sudo chmod 664
# sudo systemctl enable hangar_buddy.service

[Unit]
Description=The Hangar Buddy Service

[Service]
ExecStart=/usr/bin/python /home/pi/src/HangarBuddy/hangar_buddy.py
ExecStop=/usr/bin/pkill hangar_buddy
Group=pi
Restart=always
User=pi
WorkingDirectory=/home/pi/src/HangarBuddy

[Install]
WantedBy=default.target